{
  "name": "lite",
  "version": "2.2.1-tilly.1",
  "description": "Tilly ECC Lite — 3 agents, 7 skills, 3 commands, no hooks. Directed at local-service sites, TS web apps, sports research, job search, and furniture flipping.",
  "author": {
    "name": "Tilly",
    "url": "https://github.com/obtill199"
  },
  "homepage": "https://github.com/obtill199/ECC",
  "repository": "https://github.com/obtill199/ECC",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "lite",
    "low-token",
    "html",
    "typescript",
    "sports",
    "jobs",
    "furniture"
  ],
  "userConfig": {
    "hooks_enabled": {
      "type": "boolean",
      "title": "Enable hooks",
      "description": "Leave off. Hooks spend hidden tokens.",
      "default": false
    },
    "hook_profile": {
      "type": "string",
      "title": "Hook profile",
      "description": "Keep minimal/off.",
      "default": "minimal"
    }
  },
  "mcpServers": {},
  "agents": [
    "./lite/agents/"
  ],
  "skills": [
    "./lite/skills/"
  ],
  "commands": [
    "./lite/commands/"
  ]
}
